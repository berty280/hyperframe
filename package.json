{
  "name": "hyperframe",
  "version": "0.1.0",
  "description": "Générateur de motion graphics : rendu frame-by-frame sur canvas, export MP4/GIF via ffmpeg.",
  "type": "module",
  "bin": {
    "hyperframe": "dist/index.js"
  },
  "scripts": {
    "render": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.60"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
